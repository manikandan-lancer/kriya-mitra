# ----- App -----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ----- Postgres -----
DATABASE_URL=postgresql://neondb_owner:npg_3CEQwhjYUG2s@ep-empty-snow-aog0xefs-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- WhatsApp Cloud API -----
# From Meta Business Manager -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Random string you choose; configure the same value in the webhook config in Meta
WHATSAPP_VERIFY_TOKEN=replace-me-with-a-strong-random-string
# App secret from Meta -> App Settings -> Basic; used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# ----- Google Gemini (free tier) -----
# Get a key at https://aistudio.google.com/apikey (Google account, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----- Object storage (Cloudflare R2 or S3) -----
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kriya-mitra-media
S3_REGION=auto

# ----- Confidence thresholds -----
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.6
DIAGNOSIS_AUTO_RECOMMEND_THRESHOLD=0.75
